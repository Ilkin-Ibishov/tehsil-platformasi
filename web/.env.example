# cp .env.example .env.local — .env.local .gitignore-dadır, buraya HEÇ BİR həqiqi açar yazma.

# S1a: lokal Docker Postgres (README-dəki `docker run` komandasına uyğun).
# S1b: Supabase connection string (kod dəyişmir, yalnız bu dəyər).
DATABASE_URL=postgres://postgres:postgres@localhost:5432/tehsil

# S3: dəvət kodları — SYSTEM-REVIEW §A3-dən sonra HƏR ŞAGİRDƏ FƏRDİ (əvvəllər tək paylaşılan
# sirr idi, ADR-012). Vergüllə ayrılmış siyahı, kodun özü attempts.student_ref kimi yazılır.
# /api/solve siyahıda axtarır, uyğun olmasa 403.
INVITE_CODES=ilkin-01,ilkin-02,ilkin-03

# S3: Gemini, OpenAI-uyğun endpoint (CLAUDE.md). API_KEY YALNIZ serverdə — client komponentə düşməməlidir.
GEMINI_MODEL=gemini-3.6-flash
GEMINI_API_KEY=
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai

# ADR-022: qiymət artıq BURADA TƏYİN EDİLMİR — `web/lib/models.ts`-in registrisi
# `gemini-3.6-flash` üçün qiyməti KODDA saxlayır (86eymrm8j auditinin aşkarladığı risk:
# qiymət ayrıca env-də olanda model dəyişəndə unudula bilirdi). Naməlum/yeni model
# işlədirsənsə, qiyməti `MODEL_<MODEL_ID-nin BÖYÜK HƏRFLİ, qeyri-hərf simvolları "_"
# olan forması>_PRICE_INPUT_PER_1M`/`_OUTPUT_PER_1M` açarı ilə təyin et — məs.
# "gemini-3.7-flash" üçün `MODEL_GEMINI_3_7_FLASH_PRICE_INPUT_PER_1M`.

# SYSTEM-REVIEW-2026-08-07 §C1 (HANDOFF 41): qlobal GÜNDƏLİK xərc tavanı (USD) — device_id
# üzrə limit sıfırlana bilir, dəvət kodu paylaşılan sirrdir. Verilməzsə tavan YOXDUR (dev
# defolt) — production-da mütləq təyin et.
DAILY_COST_CEILING_USD=

# ADR-020 / ClickUp 86eykj7tu — kaskad interfeysi (Qat 1 transkripsiya → Qat 2 bank → Qat 5
# mətn LLM). **DEFOLT SÖNÜKDÜR.** `ADR-014` bu memarlıq dəyişikliyi üçün öncədən qeyd edilmiş
# ölçmə qapısı təyin edib (10 kəsilmiş şəkil: dəqiqlik ≥8/10, hallüsinasiya 0, xərc AZALSIN,
# transkripsiya ≤6 san) və "ölçülmədən qərar verilmir" yazıb. Qapı keçilməmiş açma.
# Sönükdə mövcud monolit yol bayt-bayt işləyir.
CASCADE_ENABLED=

# Qat 1 üçün kiçik/sürətli model (ClickUp 86eykqb1c). Verilməzsə GEMINI_MODEL işlədilir —
# yəni kaskad model dəyişikliyi olmadan da işləyir. DİQQƏT: model dəyişikliyi transkripsiya
# təsdiq ekranından (86eykj7x2) SONRA edilməlidir, əks halda kiçik modelin OCR səhvləri
# ÖLÇÜLMƏZ qalır və keyfiyyət səssizcə itir.
TRANSCRIBE_MODEL=

# ADR-022: AYRICA "Qat 1 qiyməti" YOXDUR artıq — Qat 1-in HƏQİQƏTƏN çağırdığı model
# (`TRANSCRIBE_MODEL` təyin edilibsə O, olmasa `GEMINI_MODEL`) öz qiymətini `models.ts`
# registrisindən (və ya yuxarıdaki `MODEL_<...>_PRICE_*` override-ından) avtomatik alır —
# "unutmaq" strukturca mümkün deyil, çünki qiymət axtarışı ÇAĞIRILAN modelin ÖZ ID-sinə
# bağlıdır, ayrıca "TRANSCRIBE" adlı bir bayraq YOXDUR.

# ClickUp 86eykj7x2 — kaskad UI (transkripsiya təsdiq ekranı). Klient `/api/solve/transcribe`
# + `/api/solve/finish` iki-endpoint axınını YALNIZ bu "1" olanda işlədir; sönükdə mövcud
# `/api/solve` monolit axını dəyişmədən qalır. `CASCADE_ENABLED` (server) İLƏ EYNİ vəziyyətdə
# saxla — server kaskadı sönükkən bu iki endpoint yenə mövcuddur (öz işini görür), amma UI-ı
# açmaq ADR-014 qapısından ƏVVƏL şagirdə çıxarmaq deməkdir.
NEXT_PUBLIC_CASCADE_ENABLED=

NEXT_PUBLIC_APP_VERSION=dev

# S1 (86eymwght) / ADR-024 — çəkilmiş şəkillərin Supabase Storage-a yüklənməsi. `SUPABASE_URL`
# sirr deyil (`https://<ref>.supabase.co`), `SUPABASE_SERVICE_ROLE_KEY` SİRRDİR — YALNIZ
# serverdə, Supabase Dashboard → Project Settings → API-dən götürülür. Hər ikisi boşdursa
# `web/lib/storage.ts::uploadCaptureImages` sükutla `null` qaytarır (best-effort, axını
# BLOKLAMIR) — `ocr_captures.storage_path` boş qalır, DB sətri yenə yazılır.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
