# scripts/eval.py bunları .env-dən oxuyur (repo kökündə .env, python-dotenv avtomatik tapır).
# Heç bir provayder hardcode edilməyib — istənilən OpenAI-uyğun /chat/completions endpoint işləyir.

MODEL=
API_KEY=
BASE_URL=

# Xərc hesablaması üçün — verilməzsə "avg_cost_usd" None qalır, harness sınmır.
PRICE_INPUT_PER_1M=
PRICE_OUTPUT_PER_1M=

# Faza 2 S1 `pdf_to_crops.py --upload` — eyni cüt `web/.env.local`-dakı Storage
# dəyişənləridir. Açar BURAYA yazılmır; skript web/.env.local və kök .env oxuyur.

# response_format={"type":"json_object"} bəzi provayderlərdə 400 qaytarır. Söndürmək üçün:
# JSON_MODE=0
JSON_MODE=1
