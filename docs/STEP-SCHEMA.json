{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://tehsil-platformasi/schemas/step-schema-v2.json",
  "title": "Solution — LLM cavab müqaviləsi v2",
  "description": "Vision LLM bu sxemə uyğun JSON qaytarmalıdır. Sərbəst mətn QƏBUL EDİLMİR. Sxem dəyişdikdə version artırılır və ADR yazılır. v2: `visual` (ADR-031).",
  "type": "object",
  "required": [
    "schema_version"
  ],
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "type": "integer",
      "enum": [1, 2],
      "description": "v2 `visual` əlavə edir (ADR-031). LLM 2 yazır; 1 keş/köhnə çıxış üçün hələ keçərlidir."
    },
    "canonical": {
      "type": "string",
      "description": "Məsələnin normallaşdırılmış təsviri. Saf düsturdursa ASCII-math (x^2-5x+6=0). Mətn məsələsidirsə orijinal mətn + içindəki düsturlar $...$ içində.",
      "minLength": 3
    },
    "problem_type": {
      "type": "string",
      "enum": [
        "formula",
        "word_problem",
        "geometry",
        "mixed"
      ],
      "description": "Uyğunlaşdırma strategiyasını seçir: formula → kanonik hash, digərləri → rəqəm izi + embedding."
    },
    "subject": {
      "type": "string",
      "enum": [
        "math",
        "physics",
        "chemistry"
      ],
      "description": "Dil-neytral kod. UI etiketi $defs.subject_labels-dədir (ADR-008). Yeni fənn = enum-a yeni kod, mövcudlar yenidən adlandırılmır."
    },
    "grade": {
      "type": "integer",
      "minimum": 5,
      "maximum": 11
    },
    "topic_code": {
      "type": "string",
      "description": "SAHƏ.MÖVZU, hər ikisi İNGİLİSCƏ və BÖYÜK HƏRFLƏ (ADR-008). UI etiketi i18n faylındadır. Valideyn hesabatındakı MÖVZULAR bölməsi buna qruplaşır.",
      "examples": [
        "ALG.QUADRATIC_EQUATION",
        "ALG.FACTORING",
        "ARITH.PERCENTAGE",
        "GEO.AREA",
        "TRIG.IDENTITIES",
        "PROB.BASIC"
      ]
    },
    "final_answer": {
      "type": "object",
      "required": [
        "latex",
        "values"
      ],
      "additionalProperties": false,
      "properties": {
        "latex": {
          "type": "string",
          "description": "Göstərilən forma: x_1 = 3,\\ x_2 = 2"
        },
        "values": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "YALNIZ riyazi cavab. Variant hərfini BURA YAZMA — onun üçün 'choice' sahəsi var. Bir neçə element yalnız cavabın özü çoxkomponentlidirsə olur (məs. iki kök: ['3','2']). Eyni cavabın alternativ yazılışlarını da bura yazmaq olar (['3/10','0.3'])."
        },
        "choice": {
          "type": "string",
          "maxLength": 4,
          "description": "Məsələdə cavab variantları varsa, düzgün variantın etiketi ('B', 'D', '3'). Variantsız məsələdə yazılmır. values-dən AYRIDIR (ADR-009)."
        }
      }
    },
    "verification": {
      "type": "object",
      "description": "Serverdə doldurulur, LLM tərəfindən YOX.",
      "additionalProperties": false,
      "properties": {
        "verified": {
          "type": "boolean"
        },
        "method": {
          "type": "string",
          "enum": [
            "mathjs_equation",
            "mathjs_unit",
            "human",
            "none"
          ]
        },
        "verified_at": {
          "type": "string",
          "format": "date-time"
        }
      }
    },
    "steps": {
      "type": "array",
      "minItems": 1,
      "maxItems": 6,
      "description": "1-6 addım. 6-dan çoxdursa məsələ çox mürəkkəbdir — bölünməlidir. 1 addım YALNIZ mənalı yoxlama mümkün olmadıqda (prompt qayda 8, HANDOFF 108).",
      "items": {
        "type": "object",
        "required": [
          "index",
          "title",
          "explanation",
          "check",
          "error_code",
          "hint"
        ],
        "additionalProperties": false,
        "properties": {
          "index": {
            "type": "integer",
            "minimum": 1
          },
          "title": {
            "type": "string",
            "maxLength": 64,
            "description": "Ekranda başlıq, əmr formasında. ≤64 simvol — UI-da kəsilir (ellipsis), bu, TƏQDİMAT məhdudiyyətidir."
          },
          "explanation": {
            "type": "string",
            "maxLength": 220,
            "description": "Addımın nə etdiyi. Cavabı VERMİR — şagird özü hesablamalıdır."
          },
          "latex": {
            "type": "string",
            "description": "Addımın düsturu, KaTeX ilə render olunur. Ola bilər ki boşdur."
          },
          "why": {
            "type": "string",
            "maxLength": 260,
            "description": "'niyə belədir' düyməsinin arxasındakı mətn. Qaydanın səbəbi, yadda saxlama yox."
          },
          "tokens": {
            "type": "object",
            "description": "Düsturdakı simvollara toxunanda çıxan izahlar. Açar = simvol, dəyər = izah.",
            "additionalProperties": {
              "type": "string",
              "maxLength": 90
            }
          },
          "check": {
            "type": "object",
            "required": [
              "ask",
              "accept"
            ],
            "additionalProperties": false,
            "description": "'Sən yaz' bloku. Bu olmadan addım keçərsizdir — məhsulun bütün fərqi buradadır.",
            "properties": {
              "ask": {
                "type": "string",
                "maxLength": 90,
                "examples": [
                  "b nəyə bərabərdir?"
                ]
              },
              "accept": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "string"
                },
                "description": "Qəbul edilən cavablar. Unicode minus (−) və ASCII minus (-) hər ikisi yazılmalıdır."
              },
              "input_kind": {
                "type": "string",
                "enum": [
                  "number",
                  "expression",
                  "choice"
                ],
                "default": "number"
              }
            }
          },
          "error_code": {
            "type": "string",
            "description": "Bu addımda səhv edilərsə hansı kateqoriya yazılır. DƏYİŞMƏZ ENUM — aşağıdakı siyahıdan.",
            "enum": [
              "SIGN_LOST",
              "SQUARE_FORGOTTEN",
              "SIGN_CHOICE",
              "SUBSTITUTION_SKIPPED",
              "ARITHMETIC",
              "FACTOR_PAIR",
              "ORDER_OF_OPS",
              "FORMULA_MISAPPLIED",
              "COEFFICIENT_READ",
              "UNIT_MISMATCH",
              "TRANSCRIPTION"
            ]
          },
          "hint": {
            "type": "string",
            "maxLength": 140,
            "description": "Səhv edildikdə görünən ipucu. Cavabı VERMİR, istiqamət verir."
          }
        }
      }
    },
    "status": {
      "type": "string",
      "enum": [
        "ok",
        "unreadable",
        "not_a_problem",
        "multiple_problems",
        "cut_off",
        "unsupported"
      ],
      "description": "Yoxdursa 'ok' sayılır. 'ok' deyilsə həll sahələri tələb olunmur, yalnız reason. Model şübhə edirsə UYDURMAQDANSA 'unreadable' qaytarmalıdır."
    },
    "ocr_confidence": {
      "type": "string",
      "enum": [
        "high",
        "medium",
        "low"
      ],
      "description": "Modelin şəkildən oxuduğu şərtə nə qədər əmin olduğu. 'low' → UI düzəliş axınını açır."
    },
    "candidates": {
      "type": "array",
      "maxItems": 5,
      "description": "YALNIZ status='multiple_problems' olduqda. Kadrda görünən məsələlərin qısa siyahısı — UI seçim ekranı göstərir, şagird toxunur, ikinci çağırış yalnız seçiləni həll edir. Bax ADR-007.",
      "items": {
        "type": "object",
        "required": [
          "label",
          "preview"
        ],
        "additionalProperties": false,
        "properties": {
          "label": {
            "type": "string",
            "maxLength": 12,
            "description": "Səhifədə çap olunmuş məsələ nömrəsi ('14'). Görünmürsə sıra nömrəsi ('1','2'). Keş açarı üçün də işlədilir — ADR-007."
          },
          "preview": {
            "type": "string",
            "maxLength": 90,
            "description": "Məsələnin ilk hissəsi, ≤90 simvol — şagirdin tanıması üçün. UI-da kəsilir."
          }
        }
      }
    },
    "reason": {
      "type": "string",
      "maxLength": 160,
      "description": "status != 'ok' olduqda istifadəçiyə göstərilən bir cümlə, giriş `locale` dilində yazılır (ADR-008)."
    },
    "detected_language": {
      "type": "string",
      "enum": [
        "az",
        "ru",
        "en",
        "tr",
        "other"
      ],
      "description": "Məsələnin ŞƏKİLDƏ yazıldığı dil. İzahların dili bundan asılı deyil — onu giriş `locale` təyin edir (ADR-008)."
    },
    "visual": {
      "$ref": "#/$defs/visual",
      "description": "Opsional. LLM SVG/path/img YAZMIR (ADR-031). Naməlum kind və ya əlavə sahə — server `visual`-ı atır, qalan JSON keçə bilər; boş şəkil uydurulmur. Server SVG çəkir (E2.3)."
    }
  },
  "$defs": {
    "visual": {
      "description": "Qapalı qrafik spesifikasiyası. oneOf — kind-ə görə sahələr. additionalProperties false: SVG/d3/path rədd.",
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind"],
          "properties": {
            "kind": { "const": "none" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "min", "max", "points"],
          "properties": {
            "kind": { "const": "number_line" },
            "min": { "type": "number" },
            "max": { "type": "number" },
            "points": {
              "type": "array",
              "maxItems": 8,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": ["x"],
                "properties": {
                  "x": { "type": "number" },
                  "label": { "type": "string", "maxLength": 16 },
                  "open": { "type": "boolean" }
                }
              }
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "k", "b"],
          "properties": {
            "kind": { "const": "linear" },
            "k": { "type": "number", "description": "y = kx + b əmsalı" },
            "b": { "type": "number", "description": "y-kəsişməsi" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "a", "b", "c"],
          "properties": {
            "kind": { "const": "quadratic" },
            "a": { "type": "number", "description": "y = ax^2 + bx + c" },
            "b": { "type": "number" },
            "c": { "type": "number" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "vertices"],
          "properties": {
            "kind": { "const": "triangle" },
            "vertices": {
              "type": "array",
              "minItems": 3,
              "maxItems": 3,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": ["x", "y"],
                "properties": {
                  "x": { "type": "number" },
                  "y": { "type": "number" },
                  "label": { "type": "string", "maxLength": 8 }
                }
              }
            },
            "sides": {
              "type": "array",
              "maxItems": 3,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": ["from", "to"],
                "properties": {
                  "from": { "type": "string", "maxLength": 8 },
                  "to": { "type": "string", "maxLength": 8 },
                  "label": { "type": "string", "maxLength": 12 }
                }
              }
            },
            "angles": {
              "type": "array",
              "maxItems": 3,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": ["at", "label"],
                "properties": {
                  "at": { "type": "string", "maxLength": 8 },
                  "label": { "type": "string", "maxLength": 12 }
                }
              }
            },
            "highlight": { "type": "string", "maxLength": 16, "description": "Təpə etiketi (C) və ya tərəf (AB)" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "center", "r"],
          "properties": {
            "kind": { "const": "circle" },
            "center": {
              "type": "object",
              "additionalProperties": false,
              "required": ["x", "y"],
              "properties": {
                "x": { "type": "number" },
                "y": { "type": "number" },
                "label": { "type": "string", "maxLength": 8 }
              }
            },
            "r": { "type": "number", "exclusiveMinimum": 0 },
            "radius_label": { "type": "string", "maxLength": 8 },
            "chord": { "$ref": "#/$defs/visual_segment" },
            "tangent": { "$ref": "#/$defs/visual_segment" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "body", "forces"],
          "properties": {
            "kind": { "const": "force_diagram" },
            "body": { "type": "string", "maxLength": 16 },
            "forces": {
              "type": "array",
              "minItems": 1,
              "maxItems": 8,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": ["label", "dir_deg", "rel"],
                "properties": {
                  "label": { "type": "string", "maxLength": 12 },
                  "dir_deg": { "type": "number", "description": "0=sağ, 90=yuxarı (fizika)" },
                  "rel": { "type": "number", "exclusiveMinimum": 0, "maximum": 2, "description": "Nisbi ox uzunluğu" }
                }
              }
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "points"],
          "properties": {
            "kind": { "const": "cartesian" },
            "points": {
              "type": "array",
              "minItems": 2,
              "maxItems": 40,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": ["x", "y"],
                "properties": {
                  "x": { "type": "number" },
                  "y": { "type": "number" }
                }
              }
            },
            "label": { "type": "string", "maxLength": 24 },
            "x_min": { "type": "number" },
            "x_max": { "type": "number" },
            "y_min": { "type": "number" },
            "y_max": { "type": "number" }
          }
        }
      ]
    },
    "visual_segment": {
      "type": "object",
      "additionalProperties": false,
      "required": ["x1", "y1", "x2", "y2"],
      "properties": {
            "x1": { "type": "number" },
            "y1": { "type": "number" },
            "x2": { "type": "number" },
            "y2": { "type": "number" },
            "label": { "type": "string", "maxLength": 12 }
      }
    },
    "error_code_labels_az": {
      "description": "UI etiketləri. Kod dəyişməz, etiket tərcümə oluna bilər. i18n faylına köçürülür.",
      "SIGN_LOST": {
        "label": "İŞARƏ İTDİ",
        "parent_note": "Mənfi əmsalı köçürəndə minusu itirir."
      },
      "SQUARE_FORGOTTEN": {
        "label": "KVADRAT UNUDULDU",
        "parent_note": "Kvadrata yüksəltməni atlayır."
      },
      "SIGN_CHOICE": {
        "label": "İŞARƏ SEÇİMİ",
        "parent_note": "± işarəsindən yanlış variantı seçir."
      },
      "SUBSTITUTION_SKIPPED": {
        "label": "YERİNƏQOYMA",
        "parent_note": "Yoxlama addımını atlayır."
      },
      "ARITHMETIC": {
        "label": "HESABLAMA",
        "parent_note": "Sadə hesab səhvi."
      },
      "FACTOR_PAIR": {
        "label": "VURUQ CÜTÜ",
        "parent_note": "Vuruqlara ayırmada cütü səhv tapır."
      },
      "ORDER_OF_OPS": {
        "label": "ƏMƏL SIRASI",
        "parent_note": "Əməllərin ardıcıllığını pozur."
      },
      "FORMULA_MISAPPLIED": {
        "label": "DÜSTUR SƏHVİ",
        "parent_note": "Düzgün düsturu yanlış yerdə tətbiq edir."
      },
      "COEFFICIENT_READ": {
        "label": "ƏMSAL OXUNUŞU",
        "parent_note": "Əmsalı tənlikdən səhv çıxarır."
      },
      "UNIT_MISMATCH": {
        "label": "VAHİD UYĞUNSUZLUĞU",
        "parent_note": "Vahidləri çevirmir."
      },
      "TRANSCRIPTION": {
        "label": "KÖÇÜRMƏ",
        "parent_note": "Rəqəmi bir sətirdən digərinə səhv köçürür."
      }
    },
    "subject_labels_az": {
      "description": "UI etiketləri. Kod dəyişməz, etiket tərcümə olunur — error_code_labels_az ilə eyni nümunə.",
      "math": "Riyaziyyat",
      "physics": "Fizika",
      "chemistry": "Kimya"
    }
  },
  "allOf": [
    {
      "if": {
        "anyOf": [
          {
            "not": {
              "required": [
                "status"
              ]
            }
          },
          {
            "properties": {
              "status": {
                "const": "ok"
              }
            },
            "required": [
              "status"
            ]
          }
        ]
      },
      "then": {
        "required": [
          "canonical",
          "subject",
          "grade",
          "topic_code",
          "final_answer",
          "steps"
        ]
      },
      "else": {
        "required": [
          "status",
          "reason"
        ]
      }
    }
  ]
}