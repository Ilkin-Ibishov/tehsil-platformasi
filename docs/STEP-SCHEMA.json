{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://tehsil-platformasi/schemas/step-schema-v1.json",
  "title": "Solution — LLM cavab müqaviləsi v1",
  "description": "Vision LLM bu sxemə uyğun JSON qaytarmalıdır. Sərbəst mətn QƏBUL EDİLMİR. Sxem dəyişdikdə version artırılır və ADR yazılır.",
  "type": "object",
  "required": [
    "schema_version"
  ],
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": 1
    },
    "canonical": {
      "type": "string",
      "description": "Məsələnin normallaşdırılmış təsviri. Saf düsturdursa ASCII-math (x^2-5x+6=0). Mətn məsələsidirsə orijinal mətn + içindəki düsturlar $...$ içində.",
      "minLength": 3
    },
    "problem_type": {
      "type": "string",
      "enum": [
        "formula",
        "word_problem",
        "geometry",
        "mixed"
      ],
      "description": "Uyğunlaşdırma strategiyasını seçir: formula → kanonik hash, digərləri → rəqəm izi + embedding."
    },
    "subject": {
      "type": "string",
      "enum": [
        "riyaziyyat",
        "fizika",
        "kimya"
      ]
    },
    "grade": {
      "type": "integer",
      "minimum": 5,
      "maximum": 11
    },
    "topic_code": {
      "type": "string",
      "description": "DİM imtahan proqramından çıxarılmış mövzu kodu. Valideyn hesabatındakı MÖVZULAR bölməsi buna qruplaşır.",
      "examples": [
        "ALG.KVADRAT_TENLIK",
        "ALG.VURUQLARA_AYIRMA",
        "ARIF.FAIZ",
        "HEND.SAHE"
      ]
    },
    "final_answer": {
      "type": "object",
      "required": [
        "latex",
        "values"
      ],
      "additionalProperties": false,
      "properties": {
        "latex": {
          "type": "string",
          "description": "Göstərilən forma: x_1 = 3,\\ x_2 = 2"
        },
        "values": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Maşınla yoxlanıla bilən dəyərlər. sympy bunları ilkin tənliyə qoyub yoxlayır."
        }
      }
    },
    "verification": {
      "type": "object",
      "description": "Serverdə doldurulur, LLM tərəfindən YOX.",
      "additionalProperties": false,
      "properties": {
        "verified": {
          "type": "boolean"
        },
        "method": {
          "type": "string",
          "enum": [
            "sympy",
            "human",
            "none"
          ]
        },
        "verified_at": {
          "type": "string",
          "format": "date-time"
        }
      }
    },
    "steps": {
      "type": "array",
      "minItems": 2,
      "maxItems": 6,
      "description": "2-6 addım. 6-dan çoxdursa məsələ çox mürəkkəbdir — bölünməlidir.",
      "items": {
        "type": "object",
        "required": [
          "index",
          "title",
          "explanation",
          "check",
          "error_code",
          "hint"
        ],
        "additionalProperties": false,
        "properties": {
          "index": {
            "type": "integer",
            "minimum": 1
          },
          "title": {
            "type": "string",
            "maxLength": 48,
            "description": "Ekranda başlıq. Əmr formasında: 'Əmsalları oxu', 'Diskriminantı hesabla'."
          },
          "explanation": {
            "type": "string",
            "maxLength": 220,
            "description": "Addımın nə etdiyi. Cavabı VERMİR — şagird özü hesablamalıdır."
          },
          "latex": {
            "type": "string",
            "description": "Addımın düsturu, KaTeX ilə render olunur. Ola bilər ki boşdur."
          },
          "why": {
            "type": "string",
            "maxLength": 260,
            "description": "'niyə belədir' düyməsinin arxasındakı mətn. Qaydanın səbəbi, yadda saxlama yox."
          },
          "tokens": {
            "type": "object",
            "description": "Düsturdakı simvollara toxunanda çıxan izahlar. Açar = simvol, dəyər = izah.",
            "additionalProperties": {
              "type": "string",
              "maxLength": 90
            }
          },
          "check": {
            "type": "object",
            "required": [
              "ask",
              "accept"
            ],
            "additionalProperties": false,
            "description": "'Sən yaz' bloku. Bu olmadan addım keçərsizdir — məhsulun bütün fərqi buradadır.",
            "properties": {
              "ask": {
                "type": "string",
                "maxLength": 90,
                "examples": [
                  "b nəyə bərabərdir?"
                ]
              },
              "accept": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "string"
                },
                "description": "Qəbul edilən cavablar. Unicode minus (−) və ASCII minus (-) hər ikisi yazılmalıdır."
              },
              "input_kind": {
                "type": "string",
                "enum": [
                  "number",
                  "expression",
                  "choice"
                ],
                "default": "number"
              }
            }
          },
          "error_code": {
            "type": "string",
            "description": "Bu addımda səhv edilərsə hansı kateqoriya yazılır. DƏYİŞMƏZ ENUM — aşağıdakı siyahıdan.",
            "enum": [
              "SIGN_LOST",
              "SQUARE_FORGOTTEN",
              "SIGN_CHOICE",
              "SUBSTITUTION_SKIPPED",
              "ARITHMETIC",
              "FACTOR_PAIR",
              "ORDER_OF_OPS",
              "FORMULA_MISAPPLIED",
              "COEFFICIENT_READ",
              "UNIT_MISMATCH",
              "TRANSCRIPTION"
            ]
          },
          "hint": {
            "type": "string",
            "maxLength": 140,
            "description": "Səhv edildikdə görünən ipucu. Cavabı VERMİR, istiqamət verir."
          }
        }
      }
    },
    "status": {
      "type": "string",
      "enum": [
        "ok",
        "unreadable",
        "not_a_problem",
        "multiple_problems",
        "cut_off",
        "unsupported"
      ],
      "description": "Yoxdursa 'ok' sayılır. 'ok' deyilsə həll sahələri tələb olunmur, yalnız reason_az. Model şübhə edirsə UYDURMAQDANSA 'unreadable' qaytarmalıdır."
    },
    "ocr_confidence": {
      "type": "string",
      "enum": [
        "high",
        "medium",
        "low"
      ],
      "description": "Modelin şəkildən oxuduğu şərtə nə qədər əmin olduğu. 'low' → UI düzəliş axınını açır."
    },
    "reason_az": {
      "type": "string",
      "maxLength": 160,
      "description": "status != 'ok' olduqda istifadəçiyə göstərilən bir cümlə. Məs. 'Şəkil bulanıqdır, düsturu oxuya bilmədim.'"
    },
    "candidates": {
      "type": "array",
      "maxItems": 5,
      "description": "YALNIZ status='multiple_problems' olduqda. Kadrda görünən məsələlərin qısa siyahısı — UI seçim ekranı göstərir, şagird toxunur, ikinci çağırış yalnız seçiləni həll edir. Bax ADR-007.",
      "items": {
        "type": "object",
        "required": [
          "label",
          "preview"
        ],
        "additionalProperties": false,
        "properties": {
          "label": {
            "type": "string",
            "maxLength": 12,
            "description": "Səhifədə çap olunmuş məsələ nömrəsi ('14'). Görünmürsə sıra nömrəsi ('1','2'). Keş açarı üçün də işlədilir — ADR-007."
          },
          "preview": {
            "type": "string",
            "maxLength": 60,
            "description": "Məsələnin ilk hissəsi — şagirdin tanıması üçün. Tam mətn deyil."
          }
        }
      }
    }
  },
  "$defs": {
    "error_code_labels_az": {
      "description": "UI etiketləri. Kod dəyişməz, etiket tərcümə oluna bilər. i18n faylına köçürülür.",
      "SIGN_LOST": {
        "label": "İŞARƏ İTDİ",
        "parent_note": "Mənfi əmsalı köçürəndə minusu itirir."
      },
      "SQUARE_FORGOTTEN": {
        "label": "KVADRAT UNUDULDU",
        "parent_note": "Kvadrata yüksəltməni atlayır."
      },
      "SIGN_CHOICE": {
        "label": "İŞARƏ SEÇİMİ",
        "parent_note": "± işarəsindən yanlış variantı seçir."
      },
      "SUBSTITUTION_SKIPPED": {
        "label": "YERİNƏQOYMA",
        "parent_note": "Yoxlama addımını atlayır."
      },
      "ARITHMETIC": {
        "label": "HESABLAMA",
        "parent_note": "Sadə hesab səhvi."
      },
      "FACTOR_PAIR": {
        "label": "VURUQ CÜTÜ",
        "parent_note": "Vuruqlara ayırmada cütü səhv tapır."
      },
      "ORDER_OF_OPS": {
        "label": "ƏMƏL SIRASI",
        "parent_note": "Əməllərin ardıcıllığını pozur."
      },
      "FORMULA_MISAPPLIED": {
        "label": "DÜSTUR SƏHVİ",
        "parent_note": "Düzgün düsturu yanlış yerdə tətbiq edir."
      },
      "COEFFICIENT_READ": {
        "label": "ƏMSAL OXUNUŞU",
        "parent_note": "Əmsalı tənlikdən səhv çıxarır."
      },
      "UNIT_MISMATCH": {
        "label": "VAHİD UYĞUNSUZLUĞU",
        "parent_note": "Vahidləri çevirmir."
      },
      "TRANSCRIPTION": {
        "label": "KÖÇÜRMƏ",
        "parent_note": "Rəqəmi bir sətirdən digərinə səhv köçürür."
      }
    }
  },
  "allOf": [
    {
      "if": {
        "anyOf": [
          {
            "not": {
              "required": [
                "status"
              ]
            }
          },
          {
            "properties": {
              "status": {
                "const": "ok"
              }
            },
            "required": [
              "status"
            ]
          }
        ]
      },
      "then": {
        "required": [
          "canonical",
          "subject",
          "grade",
          "topic_code",
          "final_answer",
          "steps"
        ]
      },
      "else": {
        "required": [
          "status",
          "reason_az"
        ]
      }
    }
  ]
}